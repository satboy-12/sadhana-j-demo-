    function updateUI() {
      const currentMlEl = document.getElementById('current-ml');
      const percentageTextEl = document.getElementById('percentage-text');
      const linearBarEl = document.getElementById('linear-bar');
      const ringCircleEl = document.getElementById('progress-ring-circle');

      currentMlEl.textContent = currentWater.toLocaleString();
      const percentage = Math.round((currentWater / goalWater) * 100);
      percentageTextEl.textContent = percentage + '% Completed';

      const linearPercent = Math.min(100, (currentWater / goalWater) * 100);
      linearBarEl.style.width = linearPercent + '%';

      // SVG Ring Stroke Offset Calculation (Radius = 70, Circumference = ~439.8)
      const circumference = 439.8;
      const offset = circumference - (Math.min(1, currentWater / goalWater) * circumference);
      ringCircleEl.style.strokeDashoffset = offset;
    }

    // Initialize on load
